# PostgreSQL connection string (the Prisma datasource provider is "postgresql")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardnurture?schema=public"
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Recommended: Claude API key. This is what makes OCR read business cards well.
# Without it, OCR falls back to Tesseract, which is markedly weaker on cards.
# Also powers personality research and supply-chain prospect research.
# ANTHROPIC_API_KEY=""

# Optional: OpenAI-compatible vision/LLM fallback, used only when
# ANTHROPIC_API_KEY is unset. Note the base URL takes no "/v1" suffix --
# the code appends "/v1/chat/completions" itself.
# LLM_API_KEY=""
# LLM_BASE_URL="https://api.openai.com"
# LLM_MODEL="gpt-4o-mini"

# Optional: Search API for better personality research (e.g., SerpAPI, Brave Search)
# If not set, falls back to DuckDuckGo HTML scraping
# SEARCH_API_KEY=""
# SEARCH_API_URL=""

# Optional: SMTP for real email sending
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# Required to enable the nurture cron endpoint.
# If unset, /api/cron/generate-nurture refuses every request with 503.
# CRON_SECRET=""
