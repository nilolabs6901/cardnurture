# PostgreSQL connection string (the Prisma datasource provider is "postgresql")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardnurture?schema=public"

# Required. The app has no sign-in screen; this single shared secret is the
# only thing gating it. Visit any URL once with ?key=<this value> and it is
# stored in an httpOnly cookie, so the gate is invisible from then on.
# If unset, every request is refused with 503 -- it fails closed on purpose.
# Generate one with: openssl rand -hex 32
APP_ACCESS_KEY="change-me-to-a-long-random-string"

# Optional. Which user account owns the data. Leave unset and the app uses
# whichever existing user holds the most contacts, which is almost always
# right. Set it only to force a specific account.
# OWNER_EMAIL=""

# Recommended: Claude API key. This is what makes OCR read business cards well.
# Without it, OCR falls back to Tesseract, which is markedly weaker on cards.
# Also powers personality research and supply-chain prospect research.
# ANTHROPIC_API_KEY=""

# Optional: OpenAI-compatible vision/LLM fallback, used only when
# ANTHROPIC_API_KEY is unset. Note the base URL takes no "/v1" suffix --
# the code appends "/v1/chat/completions" itself.
# LLM_API_KEY=""
# LLM_BASE_URL="https://api.openai.com"
# LLM_MODEL="gpt-4o-mini"

# Optional: Search API for better personality research (e.g., SerpAPI, Brave Search)
# If not set, falls back to DuckDuckGo HTML scraping
# SEARCH_API_KEY=""
# SEARCH_API_URL=""

# Optional: SMTP for real email sending
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# Required to enable the nurture cron endpoint.
# If unset, /api/cron/generate-nurture refuses every request with 503.
# CRON_SECRET=""

# Lead push into the deal-registration app (https://github.com/nilolabs6901/deal-registration-app).
# All three must be set or the "Add to lead tracker" control does not render.
#
# It targets that app's /api/leads (Kenny's own follow-up tracker), NOT /api/deals,
# which is the dealer registration system where Briggs, Ring Power and the rest
# claim end customers.
#
# DEAL_REP_* is the rep who OWNS the follow-up -- Kenny -- never the person on the
# business card. Put a prospect's address here and they become the owner of their
# own follow-up and start receiving the internal reminders.
# DEAL_APP_URL="https://web-production-7585.up.railway.app"
# DEAL_REP_NAME="Kenny Gouts"
# DEAL_REP_EMAIL="kenny.gouts@combilift.com"
