# PostgreSQL database used by Prisma. Replace the example credentials with
# the user/password configured for your local or hosted PostgreSQL instance.
DATABASE_URL="postgresql://cardnurture:***@localhost:5432/cardnurture?schema=public"

# Required by NextAuth. Use a long, random value in every environment.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Required to call /api/cron/generate-nurture. The endpoint fails closed when
# this is not set.
CRON_SECRET="replace-with-a-long-random-cron-secret"

# Optional: OpenAI-compatible LLM for enhanced parsing and personality
# analysis. Set LLM_API_KEY and LLM_BASE_URL together; LLM_MODEL defaults to
# gpt-4o-mini. The base URL should not include the /v1 path.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com"
LLM_MODEL="gpt-4o-mini"

# Optional alternative LLM provider for personality analysis.
# ANTHROPIC_API_KEY=""

# Optional: SMTP for real email sending. Set all five values together;
# otherwise email sending remains disabled.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional: Search API for better personality research (e.g., SerpAPI, Brave Search).
# If not set, the app falls back to DuckDuckGo HTML scraping.
SEARCH_API_KEY=""
SEARCH_API_URL=""
